datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  STUDENT
  STAFF
  LIBRARIAN
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  code      String   @unique
  name      String
  password  String
  role      Role     @default(STUDENT)
  avatar    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
